<Project>

  <!--
    Central package management. EVERY package version lives here and nowhere else.
    Each module owns a delimited section below: add new <PackageVersion> lines only inside your own
    section so parallel branches merge cleanly. Keep a blank line + the marker comment between sections.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ===================== SHARED ===================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- ===================== TESTS ===================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- ===================== UI: Avalonia / Editor / Shell (modules: Editor, App) ===================== -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="TextMateSharp" Version="2.0.3" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.3" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.13" />
    <PackageVersion Include="Dock.Model" Version="12.1.0.13" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.13" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.13" />
    <!-- Editor + Shell: banned-API rule (no sync-over-async / sync I/O on the UI thread) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>

  <!-- ===================== MARKDOWN PREVIEW (module: Editor, src/CsCode.Editor/Markdown/Preview) ===================== -->
  <!-- Markdig (BSD-2-Clause): CommonMark + GFM parser with source positions; the preview renders its AST to Avalonia controls. -->
  <ItemGroup>
    <PackageVersion Include="Markdig" Version="1.4.1" />
  </ItemGroup>

  <!-- ===================== LSP (module: Lsp) ===================== -->
  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
  </ItemGroup>

  <!-- ===================== DAP (module: Dap) ===================== -->
  <!-- No packages: the DAP client and protocol models are hand-written on System.Text.Json (no Newtonsoft, no VSCodeDebugProtocol). -->
  <ItemGroup>
  </ItemGroup>

  <!-- ===================== PLATFORM (module: Platform) ===================== -->
  <ItemGroup>
  </ItemGroup>

  <!-- ===================== PROFILING (module: Profiling) ===================== -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
  </ItemGroup>

</Project>
