<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CsCode.Panels.Debug.Native"
             xmlns:icons="using:CsCode.Ui.Icons"
             x:Class="CsCode.Panels.Debug.Views.MemoryView"
             x:DataType="vm:MemoryViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://CsCode.Panels.Debug/Views/DebugPanelStyles.axaml" />
    <Style Selector="ListBox.mem > ListBoxItem">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Border.target">
      <Setter Property="Background" Value="{DynamicResource vsc:editor.stackFrameHighlightBackground}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource vsc:panel.background}">
    <Border Grid.Row="0" Background="{DynamicResource vsc:sideBarSectionHeader.background}" BorderBrush="{DynamicResource vsc:panel.border}" BorderThickness="0,0,0,1" Padding="4,2">
      <Grid ColumnDefinitions="Auto,240,Auto,Auto,Auto,*">
        <TextBlock Grid.Column="0" Text="Address:" VerticalAlignment="Center" Margin="2,0,6,0" />
        <TextBox x:Name="Address" Grid.Column="1" Classes="inline" Text="{Binding AddressInput}" PlaceholderText="0x… or an expression (&amp;x, a pointer)"
                 AutomationProperties.Name="Memory address" />
        <Button Grid.Column="2" Classes="tool" Command="{Binding GoCommand}" ToolTip.Tip="Go to the address" AutomationProperties.Name="Go to address">
          <icons:Icon Kind="arrow-right" Size="14" />
        </Button>
        <Button Grid.Column="3" Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh Memory">
          <icons:Icon Kind="refresh" Size="14" />
        </Button>
        <Button Grid.Column="4" Classes="tool" Command="{Binding EditCommand}" IsEnabled="{Binding CanWrite}" ToolTip.Tip="Edit the selected row's bytes"
                AutomationProperties.Name="Edit memory">
          <icons:Icon Kind="edit" Size="14" />
        </Button>
        <TextBlock Grid.Column="5" Classes="cell dim" Text="{Binding Title}" Margin="8,0,0,0" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Classes="header">
      <Grid ColumnDefinitions="170,400,*">
        <TextBlock Grid.Column="0" Text="Address" />
        <TextBlock Grid.Column="1" Text="00 01 02 03 04 05 06 07  08 09 0a 0b 0c 0d 0e 0f" FontFamily="{DynamicResource ui:CodeFontFamily}" />
        <TextBlock Grid.Column="2" Text="Text" />
      </Grid>
    </Border>
    <ListBox x:Name="Rows" Grid.Row="2" Classes="debug mem" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             SelectionMode="Single" AutomationProperties.Name="Memory">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MemoryRow">
          <Border Classes.target="{Binding IsTarget}">
            <Grid ColumnDefinitions="170,400,*">
              <TextBlock Grid.Column="0" Classes="cell code dim" Text="{Binding AddressText}" />
              <TextBlock Grid.Column="1" Classes="cell code" Text="{Binding Hex}" />
              <TextBlock Grid.Column="2" Classes="cell code" Text="{Binding Ascii}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Classes="status" Text="{Binding StatusText}" IsVisible="{Binding ShowStatus}" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" />
  </Grid>
</UserControl>
