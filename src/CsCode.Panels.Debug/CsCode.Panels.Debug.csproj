<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tool-window panels (Debug). Views + view-models over Core services; registered as CsCode.Ui.IToolWindow. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demo/ is a separate developer project (a real window over the real DAP module), not part of this library. -->
    <Compile Remove="Demo/**" />
    <EmbeddedResource Remove="Demo/**" />
    <None Remove="Demo/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../CsCode.Ui/CsCode.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- UI-facing project: blocking calls (Task.Wait/.Result/GetResult, Thread.Sleep, sync file I/O) are build errors. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCode.Panels.Debug.Tests" />
  </ItemGroup>

</Project>
