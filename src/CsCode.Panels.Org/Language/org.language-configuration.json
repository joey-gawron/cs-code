{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "*",
      "*"
    ],
    [
      "/",
      "/"
    ],
    [
      "_",
      "_"
    ],
    [
      "=",
      "="
    ],
    [
      "~",
      "~"
    ],
    [
      "+",
      "+"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\+(?:BEGIN|begin)_",
      "end": "^\\s*#\\+(?:END|end)_"
    }
  }
}
