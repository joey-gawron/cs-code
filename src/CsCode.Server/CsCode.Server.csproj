<Project Sdk="Microsoft.NET.Sdk">

  <!-- cscode-server: the headless workspace host (docs/REMOTE.md). Runs next to the files (over ssh, or as a local child process for
       cscode.languageHost=process) and serves the file system, watcher, search and the language servers over JSON-RPC on stdio.
       Composes Platform + Lsp + Dap (adapters, tasks) + Terminal (PTY); never references Avalonia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cscode-server</AssemblyName>
    <RootNamespace>CsCode.Server</RootNamespace>
    <!-- A remote host may have no libicu: culture data is not needed by a protocol server. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Self-contained builds on a Nix-provided SDK take the official runtime packs (the SDK's own carry a /nix/store ELF interpreter). -->
  <Import Project="../../build/NuGetRuntimePacks.props" />
  <!-- The runtime, apphost, targeting and crossgen2 pack versions are pinned for a build with a runtime identifier (the app's publish ships this). -->
  <Import Project="../../build/PinnedRuntimePacks.props" />

  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../CsCode.Platform/CsCode.Platform.csproj" />
    <ProjectReference Include="../CsCode.Lsp/CsCode.Lsp.csproj" />
    <!-- R3: debug adapters and tasks run next to the files (the Dap module's factories and task runner), terminals on a local PTY here. -->
    <ProjectReference Include="../CsCode.Dap/CsCode.Dap.csproj" />
    <ProjectReference Include="../CsCode.Terminal/CsCode.Terminal.csproj" />
    <ProjectReference Include="../CsCode.Remote/CsCode.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCode.Remote.Tests" />
  </ItemGroup>

</Project>
