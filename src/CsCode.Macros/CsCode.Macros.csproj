<Project Sdk="Microsoft.NET.Sdk">

  <!-- General (non-Vim) editor macros: step model, recorder, sliced player, macros.json storage, macro.* commands. No UI dependencies:
       the shell connects it to the keyboard pipeline and the editor views (src/CsCode.App/Macros, docs/MACROS.md). -->
  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- The player runs on the UI thread: the same banned-API rule as the UI projects (no blocking waits, no sync file I/O). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <InternalsVisibleTo Include="CsCode.Macros.Tests" />
  </ItemGroup>

</Project>
