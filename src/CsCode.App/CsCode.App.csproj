<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>cscode</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The Windows executable's icon (assets/branding: 16-256 px); the window icon and the title-bar logo use the PNGs below (Views/AppIcon.cs). -->
    <ApplicationIcon>../../assets/branding/cscode.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- GC and runtime defaults chosen by the GC matrix (docs/MEMORY.md section 3) -->
  <Import Project="../../build/MemoryDefaults.props" />

  <!-- How the installed app is published (self-contained, ReadyToRun; only for `dotnet publish -r <rid>`): docs/SESSIONS.md, "Publishing". -->
  <Import Project="../../build/Publish.props" />

  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../CsCode.Platform/CsCode.Platform.csproj" />
    <ProjectReference Include="../CsCode.Lsp/CsCode.Lsp.csproj" />
    <ProjectReference Include="../CsCode.Dap/CsCode.Dap.csproj" />
    <ProjectReference Include="../CsCode.Editor/CsCode.Editor.csproj" />
    <ProjectReference Include="../CsCode.Ui/CsCode.Ui.csproj" />
    <ProjectReference Include="../CsCode.Profiling/CsCode.Profiling.csproj" />
    <ProjectReference Include="../CsCode.Panels.Debug/CsCode.Panels.Debug.csproj" />
    <ProjectReference Include="../CsCode.Panels.Search/CsCode.Panels.Search.csproj" />
    <ProjectReference Include="../CsCode.Vim/CsCode.Vim.csproj" />
    <ProjectReference Include="../CsCode.Macros/CsCode.Macros.csproj" />
    <ProjectReference Include="../CsCode.Panels.Terminal/CsCode.Panels.Terminal.csproj" />
    <ProjectReference Include="../CsCode.Panels.Git/CsCode.Panels.Git.csproj" />
    <ProjectReference Include="../CsCode.Sessions/CsCode.Sessions.csproj" />
    <ProjectReference Include="../CsCode.Remote/CsCode.Remote.csproj" />
    <!-- the headless server ships next to the app: cscode.languageHost = process runs it as a child (docs/REMOTE.md) -->
    <ProjectReference Include="../CsCode.Server/CsCode.Server.csproj" />
  </ItemGroup>

  <!-- The app icon in every size the artwork comes in (assets/branding), as Avalonia resources avares://cscode/Assets/Branding/cscode-<size>.png
       and cscode.ico: the window icon, the tray icon and the title-bar logo pick the size that fits (Views/AppIcon.cs). -->
  <ItemGroup>
    <AvaloniaResource Include="../../assets/branding/cscode-*.png;../../assets/branding/cscode.ico" Link="Assets/Branding/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- The headless-test switch of cscode (integration tests of real session processes without a display); docs/SESSIONS.md. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Banned-API rule (UI thread must never block): see BannedSymbols.txt (same list as CsCode.Ui). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <InternalsVisibleTo Include="CsCode.App.Tests" />
  </ItemGroup>

</Project>
