{
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}($2) {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "function returning a value": {
    "prefix": "fnr",
    "body": [
      "fn ${1:name}($2) -> ${3:Type} {",
      "\t$0",
      "}"
    ],
    "description": "function with a return type"
  },
  "public function": {
    "prefix": "pfn",
