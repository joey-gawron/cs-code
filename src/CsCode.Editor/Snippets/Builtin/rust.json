  "error type": {
    "prefix": "errortype",
    "body": [
      "#[derive(Debug)]",
      "pub enum ${1:Error} {",
      "\t${2:Variant},",
      "}",
      "",
      "impl std::fmt::Display for $1 {",
      "\tfn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {",
      "\t\tmatch self {",
      "\t\t\tSelf::$2 => write!(f, \"${3:message}\"),",
      "\t\t}",
      "\t}",
      "}",
      "",
      "impl std::error::Error for $1 {}$0"
    ],
    "description": "error enum with Display and std::error::Error"
  },
  "derive": {
    "prefix": "derive",
    "body": [
      "#[derive(${1:Debug, Clone, PartialEq})]"
    ],
    "description": "derive attribute"
  },
  "allow": {
    "prefix": "allow",
    "body": [
