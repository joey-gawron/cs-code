{
  "for": {
    "prefix": "for",
    "body": [
      "for (${1:std::size_t} ${2:i} = 0; $2 < ${3:count}; ++$2) {",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "for reverse": {
    "prefix": "forr",
    "body": [
      "for (${1:std::size_t} ${2:i} = ${3:count}; $2-- > 0;) {",
      "\t$0",
      "}"
    ],
    "description": "for loop, counting down"
  },
  "range-based for": {
    "prefix": "foreach",
    "body": [
      "for (${1:const auto&} ${2:item} : ${3:items}) {",
      "\t$0",
      "}"
    ],
    "description": "range-based for loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "do while": {
    "prefix": "do",
    "body": [
      "do {",
      "\t$0",
      "} while (${1:condition});"
    ],
    "description": "do-while loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "if statement"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "elseif",
    "body": [
      "else if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "else if clause"
  },
  "else": {
    "prefix": "else",
    "body": [
      "else {",
      "\t$0",
      "}"
    ],
    "description": "else clause"
  },
  "if with initializer": {
    "prefix": "ifinit",
    "body": [
      "if (auto ${1:it} = ${2:map.find(key)}; ${3:$1 != map.end()}) {",
      "\t$0",
      "}"
    ],
    "description": "if statement with an initializer (C++17)"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "case ${2:constant}:",
      "\t$3",
      "\tbreak;",
      "default:",
      "\t$0",
      "\tbreak;",
      "}"
    ],
    "description": "switch statement"
  },
  "case": {
    "prefix": "case",
    "body": [
      "case ${1:constant}:",
      "\t$0",
      "\tbreak;"
    ],
    "description": "case label"
  },
  "try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (const ${2:std::exception}& ${3:e}) {",
      "\t$0",
      "}"
    ],
    "description": "try / catch"
  },
  "main": {
    "prefix": "main",
    "body": [
      "int main(int argc, char* argv[]) {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "main function"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "${1:void} ${2:name}(${3}) {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "lambda": {
    "prefix": "lambda",
    "body": "[${1:&}](${2}) { $0 }",
    "description": "lambda expression"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "public:",
      "\t$1();",
      "\t~$1();",
      "",
      "private:",
      "\t$0",
      "};"
    ],
    "description": "class with a constructor and a destructor"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t$0",
      "};"
    ],
    "description": "struct"
  },
  "enum class": {
    "prefix": "enum",
    "body": [
      "enum class ${1:Name} {",
      "\t${0:Value},",
      "};"
    ],
    "description": "scoped enumeration (enum class)"
  },
  "namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:name} {",
      "",
      "$0",
      "",
      "} // namespace $1"
    ],
    "description": "namespace"
  },
  "template": {
    "prefix": "template",
    "body": "template <typename ${1:T}>",
    "description": "template header"
  },
  "concept": {
    "prefix": "concept",
    "body": [
      "template <typename ${1:T}>",
      "concept ${2:Name} = ${0:requires (const $1& value) { value; \\}};"
    ],
    "description": "concept definition (C++20)"
  },
  "include": {
    "prefix": "inc",
    "body": "#include <${1:vector}>",
    "description": "#include <header>"
  },
  "include local": {
    "prefix": "incl",
    "body": "#include \"${1:header.h}\"",
    "description": "#include \"header\""
  },
  "pragma once": {
    "prefix": "once",
    "body": [
      "#pragma once",
      "",
      "$0"
    ],
    "description": "#pragma once"
  },
  "include guard": {
    "prefix": "guard",
    "body": [
      "#ifndef ${1:NAME_H}",
      "#define $1",
      "",
      "$0",
      "",
      "#endif // $1"
    ],
    "description": "include guard"
  },
  "ifdef": {
    "prefix": "ifdef",
    "body": [
      "#ifdef ${1:MACRO}",
      "$0",
      "#endif // $1"
    ],
    "description": "#ifdef … #endif"
  },
  "unique_ptr": {
    "prefix": "uptr",
    "body": "auto ${1:ptr} = std::make_unique<${2:Type}>(${3});$0",
    "description": "std::make_unique"
  },
  "shared_ptr": {
    "prefix": "sptr",
    "body": "auto ${1:ptr} = std::make_shared<${2:Type}>(${3});$0",
    "description": "std::make_shared"
  },
  "vector": {
    "prefix": "vec",
    "body": "std::vector<${1:int}> ${2:values};$0",
    "description": "std::vector variable"
  },
  "static_cast": {
    "prefix": "scast",
    "body": "static_cast<${1:Type}>(${2:value})$0",
    "description": "static_cast"
  },
  "static_assert": {
    "prefix": "sassert",
    "body": "static_assert(${1:condition}, \"${2:message}\");$0",
    "description": "static_assert"
  },
  "cout": {
    "prefix": "cout",
    "body": "std::cout << ${1:value} << '\\n';$0",
    "description": "write to std::cout"
  },
  "cerr": {
    "prefix": "cerr",
    "body": "std::cerr << ${1:message} << '\\n';$0",
    "description": "write to std::cerr"
  },
  "println": {
    "prefix": "println",
    "body": "std::println(\"${1:{\\}}\", ${2:value});$0",
    "description": "std::println (C++23)"
  },
  "GoogleTest TEST": {
    "prefix": "gtest",
    "body": [
      "TEST(${1:Suite}, ${2:Name}) {",
      "\t$0",
      "}"
    ],
    "description": "GoogleTest test"
  },
  "GoogleTest TEST_F": {
    "prefix": "gtestf",
    "body": [
      "TEST_F(${1:Fixture}, ${2:Name}) {",
      "\t$0",
      "}"
    ],
    "description": "GoogleTest test in a fixture"
  },
  "GoogleTest fixture": {
    "prefix": "gfixture",
    "body": [
      "class ${1:Fixture} : public ::testing::Test {",
      "protected:",
      "\tvoid SetUp() override {",
      "\t\t$0",
      "\t}",
      "};"
    ],
    "description": "GoogleTest fixture class"
  },
  "GoogleTest TEST_P": {
    "prefix": "gtestp",
    "body": [
      "class ${1:Param} : public ::testing::TestWithParam<${2:int}> {};",
      "",
      "TEST_P($1, ${3:Name}) {",
      "\t$0",
      "}",
      "",
      "INSTANTIATE_TEST_SUITE_P(${4:Values}, $1, ::testing::Values(${5:1, 2, 3}));"
    ],
    "description": "GoogleTest parameterized test"
  },
  "EXPECT_EQ": {
    "prefix": "expect",
    "body": "EXPECT_EQ(${1:actual}, ${2:expected});$0",
    "description": "GoogleTest EXPECT_EQ"
  },
  "ASSERT_EQ": {
    "prefix": "assert",
    "body": "ASSERT_EQ(${1:actual}, ${2:expected});$0",
    "description": "GoogleTest ASSERT_EQ"
  },
  "TEST_CASE": {
    "prefix": "testcase",
    "body": [
      "TEST_CASE(\"${1:name}\") {",
      "\t$0",
      "}"
    ],
    "description": "Catch2 or doctest test case"
  },
  "TEST_CASE with tags": {
    "prefix": "testcaset",
    "body": [
      "TEST_CASE(\"${1:name}\", \"[${2:tag}]\") {",
      "\t$0",
      "}"
    ],
    "description": "Catch2 test case with tags"
  },
  "SECTION": {
    "prefix": "section",
    "body": [
      "SECTION(\"${1:name}\") {",
      "\t$0",
      "}"
    ],
    "description": "Catch2 section"
  },
  "SUBCASE": {
    "prefix": "subcase",
    "body": [
      "SUBCASE(\"${1:name}\") {",
      "\t$0",
      "}"
    ],
    "description": "doctest subcase"
  },
  "REQUIRE": {
    "prefix": "require",
    "body": "REQUIRE(${1:condition});$0",
    "description": "Catch2 / doctest REQUIRE"
  },
  "CHECK": {
    "prefix": "check",
    "body": "CHECK(${1:condition});$0",
    "description": "Catch2 / doctest CHECK"
  }
}
