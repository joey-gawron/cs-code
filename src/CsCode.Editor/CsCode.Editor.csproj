<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editing surface: AvaloniaEdit + own TextMate pipeline + language-feature UI. Owned by the Editor module (docs/EDITOR.md). -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
    <!-- EXPERIMENTAL tree-sitter engine behind editor.experimental.treeSitter (docs/TREE-SITTER-EVALUATION.md); UI-free, no packages. -->
    <ProjectReference Include="../CsCode.Editor.TreeSitter/CsCode.Editor.TreeSitter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <!-- Markdown preview: CommonMark + GFM parsing (docs/MARKDOWN.md) -->
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- UI-facing project: blocking calls (Task.Wait/.Result/GetResult, Thread.Sleep, sync file I/O) are build errors. See BannedSymbols.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language configurations for the languages VS Code ships none for (docs/LANGUAGES.md). -->
    <EmbeddedResource Include="Languages/Configurations/*.language-configuration.json" LogicalName="CsCode.Editor.Languages.Configurations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCode.Editor.Tests" />
    <InternalsVisibleTo Include="CsCode.MemoryTests" />
    <!-- docs/RUN-AND-DEBUG.md quotes the editor's debugging keys (EditorMenus.Keybindings); the docs tests check them -->
    <InternalsVisibleTo Include="CsCode.Docs.Tests" />
  </ItemGroup>

</Project>
