{
  "name": "Gruvbox Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#282828",
    "editor.foreground": "#ebdbb2",
    "editor.lineHighlightBackground": "#3c3836",
    "editor.selectionBackground": "#665c5499",
    "editor.selectionHighlightBackground": "#504945",
    "editor.wordHighlightBackground": "#504945",
    "editor.findMatchBackground": "#fabd2f66",
    "editor.findMatchHighlightBackground": "#fabd2f33",
    "editorCursor.foreground": "#ebdbb2",
    "editorLineNumber.foreground": "#7c6f64",
    "editorLineNumber.activeForeground": "#bdae93",
    "editorIndentGuide.background": "#504945",
    "editorIndentGuide.activeBackground": "#7c6f64",
    "editorWhitespace.foreground": "#504945",
    "editorBracketMatch.background": "#665c5480",
    "editorBracketMatch.border": "#7c6f64",
    "editorWidget.background": "#3c3836",
    "editorWidget.border": "#665c54",
    "editorHoverWidget.background": "#3c3836",
    "editorHoverWidget.border": "#665c54",
    "editorSuggestWidget.background": "#3c3836",
    "editorSuggestWidget.selectedBackground": "#504945",
    "editorError.foreground": "#fb4934",
    "editorWarning.foreground": "#fabd2f",
    "editorInfo.foreground": "#83a598",
    "editorGroupHeader.tabsBackground": "#1d2021",
    "editorGroup.border": "#665c54",
    "tab.activeBackground": "#282828",
    "tab.activeForeground": "#ebdbb2",
    "tab.inactiveBackground": "#1d2021",
    "tab.inactiveForeground": "#a89984",
    "tab.border": "#1d2021",
    "sideBar.background": "#1d2021",
    "sideBar.foreground": "#d5c4a1",
    "sideBar.border": "#504945",
    "sideBarTitle.foreground": "#d5c4a1",
    "activityBar.background": "#1d2021",
    "activityBar.foreground": "#d5c4a1",
    "activityBar.inactiveForeground": "#a89984",
    "activityBar.border": "#504945",
    "titleBar.activeBackground": "#1d2021",
    "titleBar.activeForeground": "#d5c4a1",
    "titleBar.inactiveBackground": "#1d2021",
    "titleBar.inactiveForeground": "#a89984",
    "statusBar.background": "#3c3836",
    "statusBar.foreground": "#d5c4a1",
    "statusBar.border": "#504945",
    "statusBar.debuggingBackground": "#d65d0e",
    "statusBar.debuggingForeground": "#fbf1c7",
    "panel.background": "#282828",
    "panel.border": "#665c54",
    "panelTitle.activeForeground": "#ebdbb2",
    "panelTitle.inactiveForeground": "#a89984",
    "list.activeSelectionBackground": "#504945",
    "list.activeSelectionForeground": "#ebdbb2",
    "list.inactiveSelectionBackground": "#3c3836",
    "list.hoverBackground": "#3c3836",
    "list.highlightForeground": "#fabd2f",
    "input.background": "#3c3836",
    "input.foreground": "#ebdbb2",
    "input.border": "#665c54",
    "input.placeholderForeground": "#a89984",
    "button.background": "#689d6a",
    "button.foreground": "#1d2021",
    "button.hoverBackground": "#8ec07c",
    "dropdown.background": "#3c3836",
    "dropdown.foreground": "#ebdbb2",
    "dropdown.border": "#665c54",
    "focusBorder": "#fabd2f",
    "foreground": "#d5c4a1",
    "descriptionForeground": "#a89984",
    "textLink.foreground": "#83a598",
    "scrollbarSlider.background": "#665c5480",
    "scrollbarSlider.hoverBackground": "#7c6f6480",
    "scrollbarSlider.activeBackground": "#7c6f64",
    "badge.background": "#689d6a",
    "badge.foreground": "#1d2021",
    "gitDecoration.modifiedResourceForeground": "#fabd2f",
    "gitDecoration.untrackedResourceForeground": "#b8bb26",
    "gitDecoration.deletedResourceForeground": "#fb4934",
    "terminal.background": "#282828",
    "terminal.foreground": "#ebdbb2"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#ebdbb2",
        "background": "#282828"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#d5c4a1"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "scope": [
        "support.constant",
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#83a598",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": "underline"
      }
    }
  ]
}
