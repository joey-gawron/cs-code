// CsCode built-in language configuration for assembly (VS Code language-configuration.json format).
// Source: NASM / MASM syntax (.asm, .nasm): ; line comments, [memory] operands, labels with . $ @ ?.
{
	"comments": {
		"lineComment": ";"
	},
	"brackets": [
		[
			"[",
			"]"
		],
		[
			"(",
			")"
		]
	],
	"autoClosingPairs": [
		{
			"open": "[",
			"close": "]"
		},
		{
			"open": "(",
			"close": ")"
		},
		{
			"open": "\"",
			"close": "\"",
			"notIn": [
				"string",
				"comment"
			]
		},
		{
			"open": "'",
			"close": "'",
			"notIn": [
				"string",
				"comment"
			]
		}
	],
	"surroundingPairs": [
		[
			"[",
			"]"
		],
		[
			"(",
			")"
		],
		[
			"\"",
			"\""
		],
		[
			"'",
			"'"
		]
	],
	"folding": {
		"markers": {
			"start": "^\\s*;\\s*#?region\\b",
			"end": "^\\s*;\\s*#?endregion\\b"
		}
	},
	"wordPattern": "[.$@?A-Za-z_][\\w.$@?]*"
}
