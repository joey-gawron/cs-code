// CsCode default keymap: "Visual Studio" (the default preset). Same format as the user's keybindings.json:
//   { "key": "ctrl+k ctrl+c", "command": "...", "when": "...", "args": ..., "mac": "...", "linux": "...", "win": "..." }
// "mac" / "linux" / "win" replace "key" on that platform; an entry with no "key" binds only on the platforms it names. Command ids are
// VS Code-compatible (editor.action.*, workbench.action.*) or the ids in KnownCommands. A key here only does something if the module that owns
// the command registers it.
// macOS: every Ctrl binding has a "mac" key (a test checks this). Cmd takes Ctrl's place as in Visual Studio for Mac and VS Code; where Cmd+key
// belongs to macOS (Cmd+H hide, Cmd+M minimize, Cmd+Q quit, Cmd+` next window, Cmd+Tab, Cmd+Space) or the Mac has no such key (Break), the
// binding follows VS Code for Mac instead, and a few keep Control as VS Code for Mac does (Ctrl+Space, Ctrl+Tab, Ctrl+`, Ctrl+G, Ctrl+-).
[
  // ---- debugging (Visual Studio: F5 / Ctrl+F5 / Shift+F5 / F9 / F10 / F11) ----
  { "key": "f5",                 "command": "workbench.action.debug.start",       "when": "!inDebugMode" },
  { "key": "f5",                 "command": "workbench.action.debug.continue",    "when": "inDebugMode" },
  { "key": "ctrl+f5",            "command": "workbench.action.debug.run",         "when": "!inDebugMode", "mac": "ctrl+f5" },
  { "key": "shift+f5",           "command": "workbench.action.debug.stop",        "when": "inDebugMode" },
  { "key": "ctrl+shift+f5",      "command": "workbench.action.debug.restart",     "when": "inDebugMode", "mac": "cmd+shift+f5" },
  { "key": "ctrl+alt+break",     "command": "workbench.action.debug.pause",       "when": "inDebugMode && debugState == 'running'", "mac": "f6" },
  { "key": "f9",                 "command": "editor.debug.action.toggleBreakpoint", "when": "editorTextFocus" },
  { "key": "f10",                "command": "workbench.action.debug.stepOver",    "when": "inDebugMode" },
  { "key": "f11",                "command": "workbench.action.debug.stepInto",    "when": "inDebugMode" },
  { "key": "shift+f11",          "command": "workbench.action.debug.stepOut",     "when": "inDebugMode" },

  // ---- navigation ----
  { "key": "f12",                "command": "editor.action.revealDefinition",     "when": "editorTextFocus" },
  { "key": "ctrl+f12",           "command": "editor.action.goToImplementation",   "when": "editorTextFocus", "mac": "cmd+f12" },
  { "key": "alt+f12",            "command": "editor.action.peekDefinition",       "when": "editorTextFocus" },
  { "key": "shift+f12",          "command": "editor.action.goToReferences",       "when": "editorTextFocus" },
  { "key": "ctrl+g",             "command": "workbench.action.gotoLine",          "mac": "ctrl+g" }, // Cmd+G is Find Next on a Mac
  { "key": "ctrl+t",             "command": "workbench.action.showAllSymbols",    "mac": "cmd+t" },
  { "key": "ctrl+,",             "command": "workbench.action.showAllSymbols",    "mac": "cmd+shift+t" }, // Cmd+, is Settings on a Mac
  { "key": "ctrl+shift+o",       "command": "workbench.action.gotoSymbol",        "when": "editorTextFocus", "mac": "cmd+shift+o" },
  { "key": "ctrl+-",             "command": "workbench.action.navigateBack",      "mac": "ctrl+-" },
  { "key": "ctrl+shift+-",       "command": "workbench.action.navigateForward",   "mac": "ctrl+shift+-" },
  { "key": "ctrl+]",             "command": "editor.action.jumpToBracket",        "when": "editorTextFocus", "mac": "cmd+shift+\\" },
  { "key": "f8",                 "command": "editor.action.marker.nextInFiles",   "when": "editorFocus" },
  { "key": "shift+f8",           "command": "editor.action.marker.prevInFiles",   "when": "editorFocus" },

  // ---- editing ----
  { "key": "f2",                 "command": "editor.action.rename",               "when": "editorTextFocus && !editorReadonly" },
  { "key": "ctrl+r ctrl+r",      "command": "editor.action.rename",               "when": "editorTextFocus && !editorReadonly", "mac": "cmd+r cmd+r" },
  { "key": "ctrl+k ctrl+d",      "command": "editor.action.formatDocument",       "when": "editorTextFocus && !editorReadonly", "mac": "cmd+k cmd+d" },
  { "key": "ctrl+k ctrl+f",      "command": "editor.action.formatSelection",      "when": "editorTextFocus && !editorReadonly", "mac": "cmd+k cmd+f" },
  { "key": "ctrl+k ctrl+c",      "command": "editor.action.addCommentLine",       "when": "editorTextFocus && !editorReadonly", "mac": "cmd+k cmd+c" },
  { "key": "ctrl+k ctrl+u",      "command": "editor.action.removeCommentLine",    "when": "editorTextFocus && !editorReadonly", "mac": "cmd+k cmd+u" },
  { "key": "ctrl+/",             "command": "editor.action.commentLine",          "when": "editorTextFocus && !editorReadonly", "mac": "cmd+/" },
  { "key": "ctrl+shift+/",       "command": "editor.action.blockComment",         "when": "editorTextFocus && !editorReadonly", "mac": "shift+alt+a" }, // Cmd+? is Help
  { "key": "ctrl+.",             "command": "editor.action.quickFix",             "when": "editorTextFocus && !editorReadonly", "mac": "cmd+." },
  { "key": "ctrl+space",         "command": "editor.action.triggerSuggest",       "when": "editorTextFocus && !editorReadonly", "mac": "ctrl+space" }, // Cmd+Space is Spotlight
  { "key": "ctrl+shift+space",   "command": "editor.action.triggerParameterHints", "when": "editorTextFocus", "mac": "cmd+shift+space" },
  { "key": "alt+up",             "command": "editor.action.moveLinesUpAction",    "when": "editorTextFocus && !editorReadonly" },
  { "key": "alt+down",           "command": "editor.action.moveLinesDownAction",  "when": "editorTextFocus && !editorReadonly" },
  { "key": "ctrl+d",             "command": "editor.action.copyLinesDownAction",  "when": "editorTextFocus && !editorReadonly", "mac": "cmd+d" },
  { "key": "ctrl+l",             "command": "editor.action.deleteLines",          "when": "editorTextFocus && !editorReadonly", "mac": "cmd+l" },
  { "key": "ctrl+shift+l",       "command": "editor.action.deleteLines",          "when": "editorTextFocus && !editorReadonly", "mac": "cmd+shift+k" },
  { "key": "ctrl+k ctrl+k",      "command": "editor.action.indentLines",          "when": "editorTextFocus && !editorReadonly", "mac": "cmd+]" },
  { "key": "ctrl+k ctrl+l",      "command": "editor.action.outdentLines",         "when": "editorTextFocus && !editorReadonly", "mac": "cmd+[" },
  { "key": "ctrl+m ctrl+m",      "command": "editor.toggleFold",                  "when": "editorTextFocus", "mac": "cmd+k cmd+l" }, // Cmd+M minimizes
  { "key": "ctrl+m ctrl+o",      "command": "editor.foldAll",                     "when": "editorTextFocus", "mac": "cmd+k cmd+0" },
  { "key": "ctrl+m ctrl+l",      "command": "editor.unfoldAll",                   "when": "editorTextFocus", "mac": "cmd+k cmd+j" },

  // ---- multiple carets: Visual Studio 2022's own keys where it has them (Shift+Alt+. Insert Next Matching Caret, Shift+Alt+; Insert Carets at
  // All Matching). VS Code's Ctrl+D, Ctrl+Shift+L and Ctrl+K Ctrl+D stay Visual Studio's Duplicate, Delete Line and Format Document here (the
  // "VS Code" preset has them); Move Last Selection to Next Find Match has no Visual Studio key (Command Palette). Alt+Click adds a caret. ----
  { "key": "shift+alt+.",        "command": "editor.action.addSelectionToNextFindMatch", "when": "editorTextFocus" },
  { "key": "shift+alt+;",        "command": "editor.action.selectHighlights",     "when": "editorTextFocus" },
  { "key": "ctrl+alt+up",        "command": "editor.action.insertCursorAbove",    "when": "editorTextFocus", "mac": "cmd+alt+up" },
  { "key": "ctrl+alt+down",      "command": "editor.action.insertCursorBelow",    "when": "editorTextFocus", "mac": "cmd+alt+down" },
  { "key": "ctrl+u",             "command": "cursorUndo",                         "when": "editorTextFocus && !vim.active", "mac": "cmd+u" },

  // ---- find ----
  { "key": "ctrl+f",             "command": "actions.find",                       "mac": "cmd+f" },
  { "key": "ctrl+h",             "command": "editor.action.startFindReplace",     "mac": "cmd+alt+f" },
  { "key": "f3",                 "command": "editor.action.nextMatchFindAction",     "when": "editorFocus", "mac": "cmd+g" },
  { "key": "shift+f3",           "command": "editor.action.previousMatchFindAction", "when": "editorFocus", "mac": "cmd+shift+g" },
  { "key": "ctrl+shift+f",       "command": "workbench.action.findInFiles",       "mac": "cmd+shift+f" },
  { "key": "ctrl+shift+h",       "command": "workbench.action.replaceInFiles",    "mac": "cmd+shift+h" },

  // ---- command surfaces ----
  { "key": "ctrl+q",             "command": "workbench.action.showCommands",      "mac": "cmd+shift+a" }, // Quick Launch opens the palette
  { "key": "ctrl+shift+p",       "command": "workbench.action.showCommands",      "mac": "cmd+shift+p" },
  { "key": "f1",                 "command": "workbench.action.showCommands" },
  { "key": "ctrl+p",             "command": "workbench.action.quickOpen",         "mac": "cmd+p" },
  {                              "command": "workbench.action.openSettings",      "mac": "cmd+," }, // Visual Studio has no Options key; a Mac app has Cmd+,

  // ---- files & editors ----
  { "key": "ctrl+n",             "command": "workbench.action.files.newUntitledFile", "mac": "cmd+n" },
  { "key": "ctrl+shift+n",       "command": "workbench.action.newWindow",         "mac": "cmd+shift+n" },
  { "key": "ctrl+o",             "command": "workbench.action.files.openFile",    "mac": "cmd+o" },
  { "key": "ctrl+shift+o",       "command": "workbench.action.files.openFolder",  "when": "!editorTextFocus", "mac": "cmd+shift+o" },
  { "key": "ctrl+s",             "command": "workbench.action.files.save",        "mac": "cmd+s" },
  { "key": "ctrl+shift+s",       "command": "workbench.action.files.saveAll",     "mac": "cmd+alt+s" },
  // ---- editor groups: Vim's window commands with Vim off (CTRL-W then a key, the second key with or without Ctrl as in Vim). Only in the
  // editor and only with Vim off (Vim's own Ctrl-W does the same); the terminal keeps Ctrl+W (delete word). Control, not Cmd, on a Mac too, as
  // in Vim. Ctrl+W alone therefore no longer closes a tab off the Mac: Ctrl+F4 does (Cmd+W on a Mac). The last key of a command is its label.
  { "key": "ctrl+w v",            "command": "workbench.action.splitEditorRight",     "when": "editorTextFocus && !vim.active", "mac": "ctrl+w v" },
  { "key": "ctrl+w ctrl+v",       "command": "workbench.action.splitEditorRight",     "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+v" },
  { "key": "ctrl+w s",            "command": "workbench.action.splitEditorDown",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w s" },
  { "key": "ctrl+w shift+s",      "command": "workbench.action.splitEditorDown",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w shift+s" },
  { "key": "ctrl+w ctrl+s",       "command": "workbench.action.splitEditorDown",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+s" },
  { "key": "ctrl+w h",            "command": "workbench.action.focusLeftGroup",       "when": "editorTextFocus && !vim.active", "mac": "ctrl+w h" },
  { "key": "ctrl+w ctrl+h",       "command": "workbench.action.focusLeftGroup",       "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+h" },
  { "key": "ctrl+w j",            "command": "workbench.action.focusBelowGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w j" },
  { "key": "ctrl+w ctrl+j",       "command": "workbench.action.focusBelowGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+j" },
  { "key": "ctrl+w k",            "command": "workbench.action.focusAboveGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w k" },
  { "key": "ctrl+w ctrl+k",       "command": "workbench.action.focusAboveGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+k" },
  { "key": "ctrl+w l",            "command": "workbench.action.focusRightGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w l" },
  { "key": "ctrl+w ctrl+l",       "command": "workbench.action.focusRightGroup",      "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+l" },
  { "key": "ctrl+w w",            "command": "workbench.action.focusNextGroup",       "when": "editorTextFocus && !vim.active", "mac": "ctrl+w w" },
  { "key": "ctrl+w ctrl+w",       "command": "workbench.action.focusNextGroup",       "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+w" },
  { "key": "ctrl+w shift+w",      "command": "workbench.action.focusPreviousGroup",   "when": "editorTextFocus && !vim.active", "mac": "ctrl+w shift+w" },
  { "key": "ctrl+w p",            "command": "workbench.action.focusPreviousGroup",   "when": "editorTextFocus && !vim.active", "mac": "ctrl+w p" },
  { "key": "ctrl+w ctrl+p",       "command": "workbench.action.focusPreviousGroup",   "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+p" },
  { "key": "ctrl+w o",            "command": "workbench.action.closeEditorsInOtherGroups", "when": "editorTextFocus && !vim.active", "mac": "ctrl+w o" },
  { "key": "ctrl+w ctrl+o",       "command": "workbench.action.closeEditorsInOtherGroups", "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+o" },
  { "key": "ctrl+w n",            "command": "cscode.shell.newUntitledFileBelow",     "when": "editorTextFocus && !vim.active", "mac": "ctrl+w n" },
  { "key": "ctrl+w ctrl+n",       "command": "cscode.shell.newUntitledFileBelow",     "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+n" },
  { "key": "ctrl+w c",            "command": "workbench.action.closeActiveEditor",    "when": "editorTextFocus && !vim.active", "mac": "ctrl+w c" },
  { "key": "ctrl+w q",            "command": "workbench.action.closeActiveEditor",    "when": "editorTextFocus && !vim.active", "mac": "ctrl+w q" },
  { "key": "ctrl+w ctrl+q",       "command": "workbench.action.closeActiveEditor",    "when": "editorTextFocus && !vim.active", "mac": "ctrl+w ctrl+q" },
  { "key": "ctrl+f4",            "command": "workbench.action.closeActiveEditor", "mac": "cmd+f4" },
  {                              "command": "workbench.action.closeActiveEditor", "mac": "cmd+w" }, // Ctrl+W starts the editor-group chords above
  { "key": "ctrl+tab",           "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup", "mac": "ctrl+tab" }, // Cmd+Tab switches apps
  { "key": "ctrl+shift+tab",     "command": "workbench.action.quickOpenLeastRecentlyUsedEditorInGroup", "mac": "ctrl+shift+tab" },
  { "key": "ctrl+pagedown",      "command": "workbench.action.nextEditor",        "mac": "cmd+alt+right" },
  { "key": "ctrl+pageup",        "command": "workbench.action.previousEditor",    "mac": "cmd+alt+left" },

  // ---- testing (Visual Studio's Ctrl+R chords; Test Explorer: Ctrl+E, T) ----
  { "key": "ctrl+r a",           "command": "testing.runAll",                     "mac": "cmd+r a" },
  { "key": "ctrl+r ctrl+a",      "command": "testing.debugAll",                   "mac": "cmd+r cmd+a" },
  { "key": "ctrl+r t",           "command": "testing.runAtCursor",                "when": "editorTextFocus", "mac": "cmd+r t" },
  { "key": "ctrl+r ctrl+t",      "command": "testing.debugAtCursor",              "when": "editorTextFocus", "mac": "cmd+r cmd+t" },
  { "key": "ctrl+r f",           "command": "testing.reRunFailTests",             "mac": "cmd+r f" },
  { "key": "ctrl+r ctrl+f",      "command": "testing.debugFailTests",             "mac": "cmd+r cmd+f" },
  { "key": "ctrl+r l",           "command": "testing.reRunLastRun",               "mac": "cmd+r l" },
  { "key": "ctrl+r ctrl+l",      "command": "testing.debugLastRun",               "mac": "cmd+r cmd+l" },
  { "key": "ctrl+e t",           "command": "workbench.view.testing.focus",       "mac": "cmd+e t" },

  // ---- tool windows ----
  { "key": "ctrl+alt+l",         "command": "workbench.view.explorer",            "mac": "cmd+alt+l" },
  { "key": "ctrl+alt+o",         "command": "workbench.action.output.toggleOutput", "mac": "cmd+alt+o" },
  { "key": "ctrl+\\ ctrl+e",     "command": "workbench.actions.view.problems",    "mac": "cmd+\\ cmd+e" },
  { "key": "ctrl+`",             "command": "workbench.action.terminal.toggleTerminal", "mac": "ctrl+`" }, // Cmd+` cycles windows

  // ---- Markdown preview (docs/MARKDOWN.md): VS Code's keys, but Ctrl+Shift+V stays Visual Studio's Cycle Clipboard Ring in Markdown files too ----
  { "key": "ctrl+shift+v",       "command": "cscode.editor.cycleClipboardRing",   "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown' && !markdownPreviewFocus", "mac": "cmd+shift+v" },
  { "key": "ctrl+k v",           "command": "markdown.showPreviewToSide",         "when": "editorLangId == 'markdown' && !markdownPreviewFocus", "mac": "cmd+k v" },
  { "key": "ctrl+shift+v",       "command": "markdown.showSource",                "when": "markdownPreviewFocus", "mac": "cmd+shift+v" },
  // ---- source control and diff (VS Code's Ctrl+Shift+G; Visual Studio's Ctrl+0, Ctrl+G would make Ctrl+0 a chord prefix) ----
  { "key": "ctrl+shift+g",       "command": "workbench.view.scm",                 "mac": "ctrl+shift+g" }, // Cmd+Shift+G is Find Previous on a Mac
  { "key": "ctrl+enter",         "command": "git.commit",                         "when": "scmInputFocus", "mac": "cmd+enter" },
  { "key": "alt+f5",             "command": "workbench.action.compareEditor.nextChange",     "when": "textCompareEditorVisible" },
  { "key": "shift+alt+f5",       "command": "workbench.action.compareEditor.previousChange", "when": "textCompareEditorVisible" }
]
