<Project Sdk="Microsoft.NET.Sdk">

  <!-- Foundation services (commands, context keys, configuration, keybindings, file system/watcher, workspace, state, logging).
       Never references Avalonia and never assumes a UI thread: see docs/PLATFORM.md (threading). -->
  <ItemGroup>
    <ProjectReference Include="../CsCode.Core/CsCode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default keymap presets ship inside the assembly (user keybindings.json layers on top). -->
    <EmbeddedResource Include="Resources/Keymaps/*.json" LogicalName="CsCode.Platform.Keymaps.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCode.Platform.Tests" />
  </ItemGroup>

</Project>
