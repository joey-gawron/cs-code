<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Default analyzer set only: this is an application, not a public SDK, so API-design rules (CA1716, CA1711...) are noise. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Transitive-package advisories must never break the build; they are surfaced in review instead. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Company>CsCode</Company>
    <Product>CsCode</Product>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Memory posture (validated/tuned by CsCode.Profiling soak tests, see docs/MEMORY.md). -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != '' and $(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests may use un-awaited fakes, unused locals in arrange blocks, etc. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2007</NoWarn>
  </PropertyGroup>

</Project>
