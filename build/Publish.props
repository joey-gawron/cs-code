<Project>

  <!--
    How CsCode is published for installing (imported by src/CsCode.App/CsCode.App.csproj; docs/SESSIONS.md, "Publishing"). The command is
    tools/publish-app.sh, which runs `dotnet publish src/CsCode.App -c Release -r linux-x64` with the self-contained switch.
    Everything here applies only to a build for a runtime identifier (-r), so `dotnet build`, `dotnet test` and `dotnet run` are untouched.
    The self-contained switch must be on the command line, not only here: the App references the cscode-server executable, and a
    self-contained executable may only reference self-contained ones (NETSDK1150).
  -->

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- Self-contained: the installed app carries its own runtime, so it runs without a dotnet on the machine (or the Nix shell). -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <!-- ReadyToRun: the app, package and framework assemblies are precompiled, so start-up does not JIT them. -->
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <!-- One composite image of the app and the framework (cross-assembly inlining; the framework's code compiled for this app): measured on
         this machine (docs/SESSIONS.md, "Start-up performance") a cold start of 0.93 s against 1.23 s with per-assembly ReadyToRun and 1.97 s
         with the JIT; +41 MB on disk and +27 MB of clean, shared file pages per process, private memory unchanged. -->
    <PublishReadyToRunComposite Condition="'$(PublishReadyToRunComposite)' == '' and '$(PublishReadyToRun)' == 'true'">true</PublishReadyToRunComposite>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <Import Project="NuGetRuntimePacks.props" />

  <!--
    The packs a publish uses are pinned: tools/publish-app.sh checks the pinned packages (size, SHA-512, SHA-256) in the NuGet cache with
    tools/fetch-publish-packs.sh before it publishes, and the publish must then use exactly those versions. The SDK picks the runtime, apphost,
    crossgen2 and ILCompiler pack versions from its own bundled list (a newer SDK would quietly restore newer, unchecked packs), so for a build
    with a runtime identifier they are set to the pinned version here. -p:CsCodePinnedRuntimeVersion=none takes the SDK's own choice (unchecked).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <CsCodePinnedRuntimeVersion Condition="'$(CsCodePinnedRuntimeVersion)' == ''">10.0.12</CsCodePinnedRuntimeVersion>
  </PropertyGroup>
  <Target Name="CsCodePinPublishPacks" BeforeTargets="ProcessFrameworkReferences" Condition="'$(RuntimeIdentifier)' != '' and '$(CsCodePinnedRuntimeVersion)' != 'none'">
    <ItemGroup>
      <KnownFrameworkReference Condition="'%(Identity)' == 'Microsoft.NETCore.App' and '%(TargetFramework)' == '$(TargetFramework)'">
        <LatestRuntimeFrameworkVersion>$(CsCodePinnedRuntimeVersion)</LatestRuntimeFrameworkVersion>
        <TargetingPackVersion>$(CsCodePinnedRuntimeVersion)</TargetingPackVersion>
      </KnownFrameworkReference>
      <KnownAppHostPack Condition="'%(Identity)' == 'Microsoft.NETCore.App' and '%(TargetFramework)' == '$(TargetFramework)'">
        <AppHostPackVersion>$(CsCodePinnedRuntimeVersion)</AppHostPackVersion>
      </KnownAppHostPack>
      <KnownCrossgen2Pack Condition="'%(Identity)' == 'Microsoft.NETCore.App.Crossgen2' and '%(TargetFramework)' == '$(TargetFramework)'">
        <Crossgen2PackVersion>$(CsCodePinnedRuntimeVersion)</Crossgen2PackVersion>
      </KnownCrossgen2Pack>
      <KnownILCompilerPack Condition="'%(Identity)' == 'Microsoft.DotNet.ILCompiler' and '%(TargetFramework)' == '$(TargetFramework)'">
        <ILCompilerPackVersion>$(CsCodePinnedRuntimeVersion)</ILCompilerPackVersion>
      </KnownILCompilerPack>
    </ItemGroup>
  </Target>

</Project>
