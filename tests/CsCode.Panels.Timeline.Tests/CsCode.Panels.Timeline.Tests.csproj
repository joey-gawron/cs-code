<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051: our APIs take an optional CancellationToken everywhere; passing TestContext's to every arrange step adds noise only. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../../src/CsCode.Ui/CsCode.Ui.csproj" />
    <ProjectReference Include="../../src/CsCode.Panels.Timeline/CsCode.Panels.Timeline.csproj" />
    <ProjectReference Include="../CsCode.TestDoubles/CsCode.TestDoubles.csproj" />
    <!-- The real Platform file system on its I/O lane (LocalFileSystem, IoLane); referenced from the TEST project only. -->
    <ProjectReference Include="../../src/CsCode.Platform/CsCode.Platform.csproj" />
  </ItemGroup>

</Project>
