<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051: our APIs take an optional CancellationToken everywhere; passing TestContext's to every arrange step adds noise only. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../CsCode.TestDoubles/CsCode.TestDoubles.csproj" />
    <ProjectReference Include="../../src/CsCode.Ui/CsCode.Ui.csproj" />
    <ProjectReference Include="../../src/CsCode.Terminal/CsCode.Terminal.csproj" />
    <ProjectReference Include="../../src/CsCode.Panels.Terminal/CsCode.Panels.Terminal.csproj" />
    <!-- The real composition (AppServices.Build + MainWindow, headless) for the end-to-end tests. -->
    <ProjectReference Include="../../src/CsCode.App/CsCode.App.csproj" />
    <ProjectReference Include="../../src/CsCode.Dap/CsCode.Dap.csproj" />
  </ItemGroup>

</Project>
