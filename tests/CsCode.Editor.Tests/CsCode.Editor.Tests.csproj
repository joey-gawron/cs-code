<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051 asks every optional CancellationToken to be TestContext.Current.CancellationToken. The pure functions under test take a
         token only to be cancellable (default = none), and several tests pass a token explicitly on purpose; the rule adds noise there. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CsCode.Core/CsCode.Core.csproj" />
    <ProjectReference Include="../CsCode.TestDoubles/CsCode.TestDoubles.csproj" />
    <ProjectReference Include="../../src/CsCode.Editor/CsCode.Editor.csproj" />
    <ProjectReference Include="../../src/CsCode.Platform/CsCode.Platform.csproj" />
    <!-- the bundled code font (CodeFonts.WithCodeFonts), so the editor lays text out in the font the app uses -->
    <ProjectReference Include="../../src/CsCode.Ui/CsCode.Ui.csproj" />
    <!-- the spell checker over the editor's real tokens (SpellCheckTokenTests, docs/SPELLCHECK.md) -->
    <ProjectReference Include="../../src/CsCode.SpellCheck/CsCode.SpellCheck.csproj" />
  </ItemGroup>

</Project>
